# GO (Gabinete Online) — Firebase Auth
# Copia a go/.env (no git) o exporta estas variables en el backend.
# Valores reales: /Users/Alvaro/.hermes/gabinete/secrets/go.env
# Cuenta de servicio JSON: /Users/Alvaro/.hermes/gabinete/secrets/tablongo-firebase-adminsdk.json

FIREBASE_PROJECT_ID=tablongo
FIREBASE_AUTH_DOMAIN=tablongo.firebaseapp.com
FIREBASE_STORAGE_BUCKET=tablongo.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=639440141487
FIREBASE_APP_ID=1:639440141487:web:76132e8c01c030b4e1e85a
FIREBASE_WEB_API_KEY=

# Admin SDK (backend). No subir este fichero ni pegarlo en chats.
GOOGLE_APPLICATION_CREDENTIALS=/Users/Alvaro/.hermes/gabinete/secrets/tablongo-firebase-adminsdk.json

# Allowlist de GO. Otros usuarios de Auth (p. ej. alvarogt@alvarogt.com) deben recibir 403.
GO_ALLOWED_EMAILS=agarciatimon@gmail.com,luzolivas@gmail.com

# Sesión propia del backend (JWT HMAC). Genera un valor largo; no lo subas.
GO_SESSION_SECRET=
GO_LISTEN=127.0.0.1:8787
GO_SITE_ROOT=
# 1 si sirves por HTTPS. En local déjalo en 0. Cloud Run lo fuerza.
GO_SECURE_COOKIE=0
